# Skopiruj na .env a doplň. .env je v .gitignore a NIKDY sa necommituje.

# --- WooCommerce REST API ---
# WooCommerce > Nastavenia > Pokrocile > REST API > Pridat kluc
# Opravnenia: "Citanie" na audit, "Citanie/Zapis" az ked realne zapisujes.
WOO_BASE_URL=https://example-shop.sk
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rezim woo-mcp servera:
#   fixtures = offline, cita mcp-servers/woo-mcp/fixtures/ (default, bezpecne)
#   store    = verejne Store API, realne data, IBA CITANIE, kluce netreba
#   dry-run  = wc/v3 naozivo, zapisy iba simuluje a vracia nahlad zmeny
#   live     = plny zapis do e-shopu
#
# Na audit staci `store` + WOO_BASE_URL. Kluce nizsie potrebuju len dry-run a live.
WOO_MODE=fixtures
